# Copy to .env and fill in. Do NOT commit .env.
# ---- Robot credentials (extracted once from the ROLA app, device-specific) ----
EBO_LICENSE=
EBO_UID=
EBO_AUTHKEY=
EBO_IDENTITY=
EBO_TOKEN=

# ---- Stream auth (mediamtx RTSP/WebRTC/HLS) ----
EBO_STREAM_USER=ebo
EBO_STREAM_PASS=change-me-rtsp

# ---- Web panel auth (http://<pi>:8000). Leave empty to disable auth. ----
EBO_WEB_USER=ebo
EBO_WEB_PASS=change-me-web

# ---- Web panel bind address ----
# Default 127.0.0.1: the panel is only reachable locally and is meant to be exposed
# over HTTPS through a reverse proxy / Cloudflare Tunnel. Set to 0.0.0.0 to expose it
# directly on the LAN (plain HTTP) instead.
EBO_BIND=127.0.0.1

# ---- Robot audio (listen-only). Defaults work for the EBO SE (G.711 µ-law, 8 kHz mono). ----
# EBO_AUDIO=0          # set to 0 to disable audio (video only)
# EBO_AUDIO_FMT=alaw   # switch to alaw if the audio sounds distorted (default: mulaw)
# The mic is quiet & noisy, so by default it is denoised, level-normalised and encoded to Opus.
# Tune the ffmpeg filter chain, or set to "none" for raw G.711 passthrough (lowest latency):
# EBO_AUDIO_FILTER=highpass=f=200,afftdn=nr=20,dynaudnorm=g=11:m=15,alimiter=limit=0.9

# ---- MQTT broker of your Home Assistant instance ----
EBO_MQTT_HOST=
EBO_MQTT_PORT=1883
EBO_MQTT_USER=
EBO_MQTT_PASS=

# ---- Optional device info for diagnostic entities ----
EBO_NAME=EBO-SE
EBO_SN=
EBO_FSN=
EBO_MCU=
EBO_CAMFW=
EBO_SSID=
EBO_ROBOT_IP=
EBO_MAC=
