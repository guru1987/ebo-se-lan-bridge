# Copy to /etc/ebo-local-responder.env (mode 0600); never commit the real UID.
EBO_RESPONDER_BIND_IP=192.168.10.135
EBO_RESPONDER_ROBOT_IP=192.168.10.149
EBO_RESPONDER_ADVERTISE_IP=192.168.10.135
EBO_RESPONDER_UID=REPLACE_WITH_20_CHAR_UID

# With the documented MikroTik hairpin rule the service sees 192.168.10.1.
# Direct traffic advertised by the responder arrives from the robot itself.
EBO_RESPONDER_ALLOWED_SOURCES=192.168.10.1,192.168.10.149
EBO_RESPONDER_LOG_LEVEL=INFO
